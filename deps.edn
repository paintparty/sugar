{:paths   ["src"]

 :deps    {org.clojure/clojure                       {:mvn/version "1.12.0"}
           ;; The local checkout or the published version. bb deps:local and bb deps:published move the #_.
           io.github.paintparty/supports-color       #_{:local/root "../supports-color"}
                                                     {:mvn/version "0.1.1"}}

 :aliases
 {:test      {:extra-paths ["test"]
              :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                            io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                  :git/sha "dfb30dd"}}}

  :jolt-test {:extra-paths ["test"]
              :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                            io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                  :git/sha "dfb30dd"}}
              :main-opts   ["-m" "cognitect.test-runner"
                            "-n" "sugar.styled-test" "-n" "sugar.snapshot-test"
                            "-n" "sugar.regression-test" "-n" "sugar.property-test" "-n" "sugar.behavior-test"]}

  :coverage  {:extra-paths ["test"]
              :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                            cloverage/cloverage    {:mvn/version "1.2.4"}}
              :main-opts   ["-m" "cloverage.coverage" "-p" "src" "-s" "test"
                            "--ns-exclude-regex" "sugar\\.(samples|sandbox|snapshot-gen)"]}

  :bench     {:extra-paths ["bench"]
              :extra-deps  {criterium/criterium {:mvn/version "0.4.6"}}
              :jvm-opts    ["-server" "-XX:-OmitStackTraceInFastThrow"]}

  ;; For developing the lib itself - uses fireworks for live feedback
  :live-code {:extra-paths ["test"]
              :extra-deps  {com.jakemccrary/test-refresh   {:mvn/version "0.26.0"}
                            io.github.paintparty/fireworks {:mvn/version "0.21.3"}
                            org.clojure/test.check         {:mvn/version "1.1.3"}}
              :main-opts   ["-m" "com.jakemccrary.test-refresh"]}

  :build     {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                           slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default build}}}
