(ns sugar.visual
  "Entry point for the `bb visual:*` tasks, which print output for a person to
   look at. Nothing is asserted.

   Each task prints a label in reverse video, the profile of the current
   process (color level, polarity, palette variants), then its content:

     palette   the palette grids and the text decorations
     samples   every case of sugar.styled-test, one per row: the rendered
               sample, the opts, and the case label
     warnings  one warning box per kind of invalid option
     platforms nothing more, for comparing detection across platforms

   Called as `sugar.visual <platform> <task> ...`, for example
   `sugar.visual nbb palette samples`."
  (:require [sugar.core :refer [styled]]
            [sugar.sample-cases :as sample-cases]
            [sugar.samples :as samples]
            [sugar.snapshot-cases :as cases]))

(defn- sample-rows []
  (let [sep "     "]
    (doseq [{:keys [label opts env]} sample-cases/cases]
      (println (str (styled "sample" opts (some-> env cases/context))
                    sep
                    (pr-str opts)
                    sep
                    (styled label {:font-weight :dim}))))))

(def ^:private task-fns
  {"palette"   #(samples/palette nil)
   "samples"   sample-rows
   "warnings"  #(samples/warnings nil)
   "platforms" (fn [])})

(def ^:private descriptions
  "Printed under a task's label, to tell the viewer what they are looking at."
  {"palette"
   (str "Every palette color, one row per variant, in italic, normal, bold and\n"
        "dim, then with background colors. Then the text decorations.")

   "samples"
   (str "These are the " (count sample-cases/cases)
        " cases of sugar.styled-test, generated by\n"
        "script/generate_tests.bb. They cover every palette color, colors with\n"
        "backgrounds, font styles and weights, underline styles, the boolean\n"
        "options, hex, rgb and 8-bit colors, keyword and string opts, and mocked\n"
        "color levels and polarities. The tests only check that styled returns a\n"
        "string, so this is where a human can visually confirm that each case\n"
        "looks correct.\n"
        "\n"
        "Each row has 3 columns. The first is the word \"sample\" styled with the\n"
        "case's opts. The second is the opts passed to styled. The third is the\n"
        "case label. A label that starts with \"level-0\" to \"level-3\" mocks that\n"
        "color level. A label that includes \"-polarity-dark\" or\n"
        "\"-polarity-light\" mocks the terminal's polarity (dark or light). Every\n"
        "other row uses this terminal's own level and polarity, shown in the\n"
        "profile below.")

   "warnings"
   (str "One warning box per kind of invalid option. Each box should name the\n"
        "option, show the value passed, and list what the option accepts.")

   "platforms"
   (str "What this runtime detected in this terminal. The 4 runtimes print one\n"
        "after another, and their profiles should match.")})

(defn run
  "Prints each named task: a bold label in reverse video, the task's
   description if it has one, the profile block, then the task's output."
  [platform & tasks]
  (doseq [task tasks]
    (println)
    (println (styled (str " visual:" task " · " platform " ")
                     {:reverse true :font-weight :bold}))
    (when-let [d (get descriptions task)]
      (println)
      (println d))
    ;; The profile block starts with its own blank line.
    (styled "" {:dev/print-profile true})
    (println)
    ((get task-fns task #(println "Unknown visual task:" task)))
    (println)))

(defn -main [& args]
  (apply run args))

#?(:cljs
   (defn main
     "Entry point for the shadow-cljs :node-script build."
     [& args]
     (apply run args)))
